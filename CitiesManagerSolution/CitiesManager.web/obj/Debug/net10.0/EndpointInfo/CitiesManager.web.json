{
  "openapi": "3.0.4",
  "info": {
    "title": "Orders Version 1",
    "version": "1.0"
  },
  "paths": {
    "/api/v1/Account": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Registers a new user account with the specified registration details.",
        "description": "If the specified email address is already registered, the method returns a problem\r\n            response. The method also assigns the user to the specified role, creating the role if it does not exist.\r\n            The user is automatically signed in upon successful registration. This endpoint expects a valid RegisterDTO\r\n            payload and should be called via HTTP POST.",
        "requestBody": {
          "description": "An object containing the user's registration information, including email, password, display name, desired\r\n            role, and sign-in preferences. Cannot be null. All required fields must be valid.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDTO"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationUser"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Checks whether the specified email address is already associated with an existing user account.",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "description": "The email address to check for availability. Can be null.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/Cities": {
      "get": {
        "tags": [
          "Cities"
        ],
        "summary": "Retrieves all cities from the data store.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/City"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Cities"
        ],
        "summary": "Creates a new city and adds it to the data store.",
        "description": "If the operation is successful, the response has HTTP status code 201 (Created) and\r\n            includes the created city in the response body. The location header points to the endpoint for retrieving\r\n            the newly created city.",
        "requestBody": {
          "description": "The city entity to add. Must not be null.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/City"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/City"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/City"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/Cities/{id}": {
      "get": {
        "tags": [
          "Cities"
        ],
        "summary": "Retrieves the city with the specified unique identifier.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The unique identifier of the city to retrieve.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/City"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Cities"
        ],
        "summary": "Updates the details of an existing city with the specified identifier.",
        "description": "If the specified city does not exist, the method returns a 404 Not Found response. If\r\n            the id does not match the `CityId` of the provided city, the\r\n            method returns a 400 Bad Request response. Concurrency conflicts during the update will result in an\r\n            exception unless the city no longer exists.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The unique identifier of the city to update.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "The updated city data. The CitiesManager.Core.Entities.City.CityId property must match the id\r\n            parameter.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/City"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/City"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "tags": [
          "Cities"
        ],
        "summary": "Deletes the city with the specified unique identifier.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The unique identifier of the city to delete.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/Test/Index": {
      "get": {
        "tags": [
          "Test"
        ],
        "summary": "Handles HTTP GET requests and returns a simple greeting message.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApplicationUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userName": {
            "type": "string",
            "nullable": true
          },
          "normalizedUserName": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "normalizedEmail": {
            "type": "string",
            "nullable": true
          },
          "emailConfirmed": {
            "type": "boolean"
          },
          "passwordHash": {
            "type": "string",
            "nullable": true
          },
          "securityStamp": {
            "type": "string",
            "nullable": true
          },
          "concurrencyStamp": {
            "type": "string",
            "nullable": true
          },
          "phoneNumber": {
            "type": "string",
            "nullable": true
          },
          "phoneNumberConfirmed": {
            "type": "boolean"
          },
          "twoFactorEnabled": {
            "type": "boolean"
          },
          "lockoutEnd": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "lockoutEnabled": {
            "type": "boolean"
          },
          "accessFailedCount": {
            "type": "integer",
            "format": "int32"
          },
          "personName": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "City": {
        "required": [
          "cityName"
        ],
        "type": "object",
        "properties": {
          "cityId": {
            "type": "string",
            "format": "uuid"
          },
          "cityName": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RegisterDTO": {
        "required": [
          "confirmPassword",
          "email",
          "password",
          "personName",
          "userRole"
        ],
        "type": "object",
        "properties": {
          "personName": {
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          },
          "confirmPassword": {
            "minLength": 1,
            "type": "string"
          },
          "userRole": {
            "minLength": 1,
            "type": "string"
          },
          "stayLoggedIn": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  }
}